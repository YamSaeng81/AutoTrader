diff --git a/web-api/src/test/java/com/cryptoautotrader/api/service/EntryRoundsCrossRoundPaperDelayTest.java b/web-api/src/test/java/com/cryptoautotrader/api/service/EntryRoundsCrossRoundPaperDelayTest.java
