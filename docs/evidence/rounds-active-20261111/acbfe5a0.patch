+        } catch (java.util.concurrent.RejectedExecutionException rejected) {
+            long n = alignedRtRejected.incrementAndGet();
+            if (n == 1 || n % 100 == 0) {
+                log.warn("모의투자[LIVE_ALIGNED] 실시간 작업 거절 — 이 시세는 버린다(실자금 처리기에 영향 없음), 누적 {}건 coin={}",
+                        n, event.getCoinCode());
+            }
         }
     }
 
