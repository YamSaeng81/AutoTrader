@@ -0,0 +1,94 @@
+import { test, expect, type Page, type Route } from '@playwright/test';
+import fs from 'node:fs';
+import path from 'node:path';
+
+/**
+ * 총괄 v1.177 §3-5·v1.178 §4-4 — PAPER 상세 "가격 차트 (매수/매도 시점)" 카드 제목의 밝은/어두운 테마 대비(2026-11-17).
+ * 서버 없이 /api/proxy/** 를 가로채 대역 응답(값은 형식용, 운영·실측 아님)으로 차트를 그린다. 제목 글자색과 그 뒤에 실제로 칠해진 배경색을
+ * 브라우저 캔버스로 sRGB 픽셀로 바꿔(반투명 배경은 아래층 위에 합성) WCAG 대비를 잰다. 기준 4.5:1(본문 글자). 카드 사진을 OUT 에 남긴다.
+ */
+const OUT = process.env.CHART_CONTRAST_OUT ?? path.join(__dirname, '..', 'test-results', 'chart-title-contrast');
+fs.mkdirSync(OUT, { recursive: true });
+const SID = 9201;
+const TITLE = '가격 차트 (매수/매도 시점)';
+
+async function serve(page: Page) {
+  const t0 = Date.parse('2026-11-12T00:00:00Z');
+  const candles = Array.from({ length: 30 }, (_, i) => ({ time: t0 + i * 3_600_000, close: 100_000_000 + i * 50_000 }));
+  const session = {
+    id: SID, strategyName: 'DAILY_SMA20', coinPair: 'KRW-BTC', timeframe: 'H1', status: 'RUNNING',
+    availableKrw: 200, initialCapital: 20200, realizedPnl: 0, totalFee: 10, startedAt: '2026-11-11T00:00:00Z', stoppedAt: null,
+    strategyParams: { paperExecutionMode: 'LIVE_ALIGNED' }, pendingCloseCount: 0, valuationStatus: 'VALUED',
+    totalAssetKrw: 20230.4, totalReturnPct: 0.15, positionValueKrw: 20030.4, costBasisKrw: 20000, unrealizedPnl: 30.4, positionPnlPct: 0.15,
+  };
+  await page.route('**/api/proxy/**', async (route: Route) => {
+    const p = new URL(route.request().url()).pathname.replace(/^\/api\/proxy/, '');
+    const ok = (data: unknown) => route.fulfill({ status: 200, contentType: 'application/json', body: JSON.stringify({ success: true, data, error: null }) });
+    if (p === `/api/v1/paper-trading/sessions/${SID}`) return ok(session);
+    if (p === `/api/v1/paper-trading/sessions/${SID}/chart`)
+      return ok({ candles, orders: [{ side: 'BUY', orderType: 'MARKET', price: 100_500_000, quantity: 0.0002, filledAt: new Date(t0 + 10 * 3_600_000).toISOString() }] });
+    if (p === `/api/v1/paper-trading/sessions/${SID}/orders`) return ok({ content: [], totalElements: 0, totalPages: 0, number: 0, size: 20 });
+    if (p === '/api/v1/paper-trading/sessions') return ok([session]);
+    return ok([]);
+  });
+}
+
+/** 제목 글자색·실제 배경색(불투명해질 때까지 조상 배경을 아래에서부터 합성)을 sRGB 로 바꿔 WCAG 대비를 돌려준다. */
+async function contrast(page: Page) {
+  return page.getByRole('heading', { name: TITLE }).evaluate((h) => {
+    const cv = document.createElement('canvas');
+    cv.width = cv.height = 1;
+    const ctx = cv.getContext('2d', { willReadFrequently: true })!;
+    const rgba = (css: string) => {
+      ctx.clearRect(0, 0, 1, 1);
+      ctx.fillStyle = '#000';
+      ctx.fillStyle = css;
+      ctx.fillRect(0, 0, 1, 1);
+      const d = ctx.getImageData(0, 0, 1, 1).data;
+      return [d[0], d[1], d[2], d[3] / 255];
+    };
+    const layers: number[][] = [];
+    const names: string[] = [];
+    for (let el: Element | null = h; el; el = el.parentElement) {
+      const bg = getComputedStyle(el).backgroundColor;
+      const c = rgba(bg);
+      if (c[3] > 0) { layers.push(c); names.push(`${el.tagName.toLowerCase()}.${(el.getAttribute('class') ?? '').split(' ').slice(0, 2).join('.')}=${bg}`); }
+      if (c[3] >= 1) break;
+    }
+    let base = [255, 255, 255];   // 끝까지 불투명 배경이 없으면 흰 바탕(브라우저 기본)
+    for (let i = layers.length - 1; i >= 0; i--) {
+      const [r, g, b, a] = layers[i];
+      base = [r * a + base[0] * (1 - a), g * a + base[1] * (1 - a), b * a + base[2] * (1 - a)];
+    }
+    const fg = rgba(getComputedStyle(h).color);
+    const lum = (c: number[]) => {
+      const f = (v: number) => { v /= 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };
+      return 0.2126 * f(c[0]) + 0.7152 * f(c[1]) + 0.0722 * f(c[2]);
+    };
+    const [l1, l2] = [lum(fg), lum(base)].sort((a, b) => b - a);
+    return { ratio: Math.round(((l1 + 0.05) / (l2 + 0.05)) * 100) / 100, fg: fg.slice(0, 3), bg: base.map(Math.round), layers: names,
+             htmlDark: document.documentElement.classList.contains('dark') };
+  });
+}
+
+for (const theme of ['light', 'dark'] as const) {
+  test(`차트 제목 대비 — ${theme}`, async ({ page }) => {
+    await page.setViewportSize({ width: 1440, height: 1000 });
+    await page.addInitScript((t) => {
+      localStorage.setItem('theme', t);
+      const hide = () => { const s = document.createElement('style'); s.textContent = 'nextjs-portal { display: none !important; }'; document.head.appendChild(s); };
+      if (document.head) hide(); else document.addEventListener('DOMContentLoaded', hide);
+    }, theme);
+    await serve(page);
+    await page.goto(`/paper-trading/${SID}`);
+    const h = page.getByRole('heading', { name: TITLE });
+    await expect(h).toBeVisible();
+    const c = await contrast(page);
+    fs.writeFileSync(path.join(OUT, `${theme}.json`), JSON.stringify(c, null, 2));
+    console.log(`[대비] ${theme} ${JSON.stringify(c)}`);
+    await h.locator('xpath=ancestor::div[contains(@class,"rounded-2xl")][1]').screenshot({ path: path.join(OUT, `${theme}-card.png`) });
+    await page.screenshot({ path: path.join(OUT, `${theme}-page.png`), fullPage: true });
+    expect(c.htmlDark).toBe(theme === 'dark');
+    expect(c.ratio, `제목 대비 ${c.ratio}:1 (글자 ${c.fg} / 배경 ${c.bg})`).toBeGreaterThanOrEqual(4.5);
+  });
+}
