+    private static Map<String, Object> rawItem(Object market, Object price) {
+        Map<String, Object> t = new HashMap<>();
+        t.put("market", market);
+        t.put("trade_price", price);
+        t.put("trade_timestamp", Instant.now().minusSeconds(1).toEpochMilli());
+        return t;
+    }
