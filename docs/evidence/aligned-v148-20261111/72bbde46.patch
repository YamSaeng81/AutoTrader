+        map.put("exitDecidedAt", p.getExitDecidedAt() != null ? p.getExitDecidedAt().toString() : null);
+        map.put("realizedPnl", null);
+        map.put("status", p.getStatus());
+        map.put("openedAt", p.getOpenedAt().toString());
+        map.put("closedAt", null);
+        return map;
+    }
