 .../DataControllerIntegrationTest.java        |  9 ++++
 .../service/SchedulerProfileCleanupTest.java  | 52 ++++++++++++++++++-
 2 files changed, 60 insertions(+), 1 deletion(-)

diff --git a/web-api/src/test/java/com/cryptoautotrader/api/controller/DataControllerIntegrationTest.java b/web-api/src/test/java/com/cryptoautotrader/api/controller/DataControllerIntegrationTest.java
index 11867ac9..3a75c0c3 100644
