+            assertThat(peakMemEmptyAtStart).isTrue();
+            assertThat(afterRestart.isTriggered()).isTrue();
+            assertThat(repo2.findMddPeakKrw(p.getId())).isEqualByComparingTo("30000");
+            assertThat(restoredAtBoot).contains(qp.getId());
