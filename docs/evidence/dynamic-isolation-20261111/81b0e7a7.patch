+        return logs.isEmpty() ? "로그 없음" : logs.get(0).getSignal() + " / " + logs.get(0).getReason()
+                + (logs.get(0).getBlockedReason() != null ? " / 차단=" + logs.get(0).getBlockedReason() : "");
