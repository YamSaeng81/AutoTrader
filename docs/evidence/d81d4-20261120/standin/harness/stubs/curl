#!/bin/bash
# frontend 응답 확인 한 형태와 V171D4 이미지 API 조회 한 형태만 받는다(그 밖은 금지). 응답 코드는 FE_HTTP(기본 200), API 실패 주입 API_FAIL.
. "$(dirname "$0")/_lib.sh"; calllog curl "$@"
[ -f "$SIM/env.sh" ] && . "$SIM/env.sh"
PYREAL='/c/Users/SangJoon_Lee/AppData/Local/Microsoft/WindowsApps/PythonSoftwareFoundation.Python.3.13_qbz5n2kfra8p0/python.exe'
if [ $# = 4 ] && [ "$1" = -sf ] && [ "$2" = --unix-socket ] && [ "$3" = /var/run/docker.sock ]; then
  case "$4" in http://localhost/v1.56/images/sha256:*/json\?manifests=1) ;; *) forbid curl-api "$@" ;; esac
  t=${4#http://localhost/v1.56/images/}; t=${t%/json\?manifests=1}
  [ -z "${API_FAIL:-}" ] || exit 22
  [ -e "$ST/img/${t#sha256:}" ] || exit 22
  PYTHONUTF8=1 "$PYREAL" -I -X utf8 "$(dirname "$0")/../imgstate.py" api "$ST" "$t" | tr -d '\r'; exit ${PIPESTATUS[0]}
fi
# V172D4: 보존 태그 조회(tagq) 한 형태 — GET /v1.56/images/<참조>/json. 운영 응답 형식(state-1258): 있음 200 {"Id":…} · 없음 404 {"message":"No such image: <참조>"} · 소켓 실패 curl 종료 7
# 고장 주입 TAGQ_FAULT="<참조>=<방식>[ <참조>=<방식>…]"(참조 * = 전부): rc7 = curl 종료 7 · http500 · badbody(200 인데 형식 이상) · nf404(404 인데 다른 본문)
if [ $# = 6 ] && [ "$1" = -s ] && [ "$2" = -w ] && [ "$3" = '\n%{http_code}' ] && [ "$4" = --unix-socket ] && [ "$5" = /var/run/docker.sock ]; then
  case "$6" in http://localhost/v1.56/images/*/json) ;; *) forbid curl-tagq "$@" ;; esac
  r=${6#http://localhost/v1.56/images/}; r=${r%/json}
  case "$r" in autotrader-backend:*|autotrader-frontend:*) ;; *) forbid curl-tagq-ref "$@" ;; esac
  set -f; fm=""; for f in ${TAGQ_FAULT:-}; do case "$f" in "$r="*|"*="*) fm=${f#*=} ;; esac; done
  case "$fm" in
    rc7) exit 7 ;;
    http500) printf '{"message":"대역 daemon 오류"}\n\n500'; exit 0 ;;
    badbody) printf 'not-json\n\n200'; exit 0 ;;
    nf404) printf '404 page not found\n\n404'; exit 0 ;;
  esac
  case "$r" in
    autotrader-backend:*) f=$ST/tag/${r#autotrader-backend:} ;;
    autotrader-frontend:latest) f=$ST/fetag/latest ;;
    autotrader-frontend:*) f=$ST/fetag/${r#autotrader-frontend:} ;;
  esac
  if [ -e "$f" ]; then printf '{"Id":"%s","RepoTags":["%s"]}\n\n200' "$(cat "$f")" "$r"; else printf '{"message":"No such image: %s"}\n\n404' "$r"; fi
  exit 0
fi
[ "$*" = "-s -o /dev/null -w %{http_code} http://localhost:3000/" ] || forbid curl "$@"
printf '%s' "${FE_HTTP:-200}"
