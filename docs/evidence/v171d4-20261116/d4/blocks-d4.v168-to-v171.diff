+icpy() { [ -e "$M/imgchain.py" ] || printf '%s' "$ICPY" > "$M/imgchain.py"; [ "$(h256 "$M/imgchain.py")" = "$ICSUM" ] || { echo "🔴 $M/imgchain.py 원문 해시가 ICSUM 과 다름" >&2; return 9; } ; }
