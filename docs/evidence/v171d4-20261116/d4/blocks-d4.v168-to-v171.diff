+ok3() { cut -d' ' -f1-3 "$1" ; }   # 대응 기록 파일 → "대상 manifest config"
+okimg() { echo "$(cut -d' ' -f1 "$1") $(cut -d' ' -f3 "$1")" ; }   # 새로 만든 컨테이너의 .Image 허용값 = 대상 ID 또는 config
+same3() {   # same3 <이미지 참조> <대응 기록 파일> — 참조의 대상·manifest·config 가 기록과 같은지(조회 실패는 다름)
