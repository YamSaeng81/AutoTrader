#!/bin/bash
# 가짜 docker(V171D4 대역) — 상태는 $SIM/state 파일. 실제 docker 를 부르지 않는다.
# V171D4: containerd 이미지 저장소 흉내 — 이미지 = 대상 ID(index)·linux/amd64 manifest·config(../imgstate.py), 컨테이너 = ID·.Image·ImageManifestDescriptor($ST/ctr/<서비스>).
#   새로 만든 컨테이너의 .Image 는 대상 ID(UP_IMG_CONFIG=1 이면 config). 운영 frontend 의 .Image d825a9f5 는 이미지가 아니다(이미지 참조로 쓰면 No such image).
. "$(dirname "$0")/_lib.sh"; calllog docker "$@"
[ -f "$SIM/env.sh" ] && . "$SIM/env.sh"
PYREAL='/c/Users/SangJoon_Lee/AppData/Local/Microsoft/WindowsApps/PythonSoftwareFoundation.Python.3.13_qbz5n2kfra8p0/python.exe'
IS="$(dirname "$0")/../imgstate.py"
isp() { PYTHONUTF8=1 "$PYREAL" -I -X utf8 "$IS" "$@"; }
idof() {   # 참조(태그 또는 sha256:id) → 대상 id, 없으면 1
  case "$1" in
    sha256:*) [ -e "$ST/img/${1#sha256:}" ] && echo "$1" ;;
    autotrader-backend:*) [ -e "$ST/tag/${1#autotrader-backend:}" ] && cat "$ST/tag/${1#autotrader-backend:}" ;;
    autotrader-frontend) cat "$ST/fetag/latest" ;;   # 이미지 이름(태그 없음 = latest)
    autotrader-frontend:*) [ -e "$ST/fetag/${1#autotrader-frontend:}" ] && cat "$ST/fetag/${1#autotrader-frontend:}" ;;
    *) return 1 ;;
  esac
}
svcofcid() { local s; for s in backend frontend db redis db-backup; do [ "$(cut -d' ' -f1 "$ST/ctr/$s" 2>/dev/null)" = "$1" ] && { echo "$s"; return 0; }; done; return 1; }
setctr() {   # setctr <서비스> <대상 id> — 새 컨테이너(새 ID·.Image·manifest)
  local s=$1 t=$2 m c img cid
  read -r m c < "$ST/man/${t#sha256:}"
  img=$t; [ -z "${UP_IMG_CONFIG:-}" ] || img=$c
  cid=$(printf 'standin-ctr-%s-%s-%s' "$s" "$t" "$(now)" | sha256sum | cut -c1-64)
  echo "$cid $img $m" > "$ST/ctr/$s"
  if [ "$s" = backend ]; then echo "$img" > "$ST/backend.image"; else echo "$img" > "$ST/svc/$s"; fi
}
startofsvc() { case "$1" in backend) cat "$ST/backend.started" ;; frontend) cat "$ST/frontend.started" 2>/dev/null || echo 2026-10-21T04:45:59.089630967Z ;; *) echo 2026-11-01T00:00:00.000000000Z ;; esac; }
sql() {
  case "$1" in
    *"count(*) AS total"*) echo "${SC_OUT:-66 | 63 | 3 | -}" ;;
    *"capital_stage_baseline) || '|' ||"*) echo "${EG_OUT:-1|0|1|true|157,161,166,167,168,183,184,185,186,187,188,189,190,191,192,193,194,195,196,200|92|0}" ;;
    *"strategy_type = 'DAILY_SMA20'"*) echo t ;;
    *"available_krw = 20200"*) echo t ;;
    *"string_agg(id || ':' || status, ','"*) echo "${LIVE1_OUT:-203:CREATED}" ;;
    *"SELECT stage || '|'"*) echo 'STAGE_1|2026-10-30 04:16:57.997762|100000.00' ;;
    *real_open_positions*) printf '%s 0\n' real_open_positions real_unresolved_orders cleanup_pending sid_orders sid_positions ;;
    *"string_agg(version"*) [ -e "$ST/v96" ] && echo "96:t:${V96CK:--424836241}" || echo "" ;;   # V159D4: V95 이후 이력
    *flyway_schema_history*) if [ -n "${V_OUT:-}" ]; then echo "$V_OUT"; elif [ -e "$ST/v96" ]; then echo 96; else echo 94; fi ;;
    *"SHOW TimeZone"*) echo Etc/UTC ;;
    *market_data_cache*) echo "${BTC_OUT:-true|11-07 09:00|11-07 09:00|20/20}" ;;
    *news_source_config*) printf '%s\n' 'rss-1|RSS|t|15|1793927000' 'cp-1|CRYPTOPANIC|f|30|-' ;;
    *) echo "대역 SQL 미정의: ${1:0:80}" >&2; return 3 ;;
  esac
}
if [ "$1" = compose ]; then
  shift; [ "$1" = -f ] && shift 2
  sub=$1; shift
  case "$sub" in
    ps) if [ "$1" = -q ]; then [ -z "${PSQ_FAIL:-}" ] || exit 1; cut -d' ' -f1 "$ST/ctr/$2" 2>/dev/null; else echo "NAME IMAGE STATUS"; echo "autotrader-backend-1 $(cat "$ST/backend.image" | cut -c1-19) Up (대역)"; fi ;;
    exec)
      [ "$1" = -T ] && shift; svc=$1; shift
      if [ "$svc" = db ]; then
        q=""; for ((i=1; i<=$#; i++)); do [ "${!i}" = -c ] && { j=$((i+1)); q=${!j}; }; done
        if [ -n "$q" ]; then sql "$q"; exit $?; fi
        t=$(mktemp); cat > "$t"   # 표준 입력 SQL 을 내용으로 가른다(손실 조회 v2·관문 3판·관문 장부 COPY·종전 qc)
        if grep -q "preflight.asof" "$t"; then rm -f "$t"; [ -n "${PF_RC:-}" ] && { echo "ERROR:  대역 조회 실패" >&2; exit "$PF_RC"; }; cat "$SIM/fix/preflight.txt"; exit 0; fi
        if grep -q "'GATE'" "$t"; then rm -f "$t"; cat "$SIM/fix/gate.txt"; exit 0; fi
        if grep -q "COPY (" "$t"; then rm -f "$t"; echo "id,대역"; exit 0; fi
        rm -f "$t"; cat "$SIM/fix/qc.txt"; exit 0
      fi
      case "$1" in
        env) printf '%s\n' TRADING_CAPITALPOOL_STAGE=STAGE_1 TRADING_CAPITALPOOL_TOTALCAPKRW=100000 TRADING_CAPITALPOOL_PERPOSITIONCAPKRW=${POOL_PER:-20000} TRADING_CAPITALPOOL_MAXCONCURRENTPOSITIONS=3 SPRING_PROFILES_ACTIVE=prod ;;
        date) shift; date "$@" ;;
        *) forbid "docker-exec-$1" "$@" ;;
      esac ;;
    build)
      if [ "$1" = frontend ]; then   # frontend 이미지 빌드(대역 id), 실패 주입 FE_BUILD_FAIL(이름 그대로)·FE_BUILD_FAIL_AFTER_TAG(이름이 바뀐 뒤 실패)
        [ -z "${FE_BUILD_FAIL:-}" ] || { echo "(대역) frontend 빌드 실패 주입"; exit 1; }
        id=$(isp build "$ST" frontend "fe-$(cat "$ST/HEAD")-$(now)") || exit 1
        echo frontend > "$ST/img/${id#sha256:}"; echo "$id" > "$ST/fetag/latest"; echo "(대역) building frontend → ${id:0:19}"
        [ -z "${FE_BUILD_FAIL_AFTER_TAG:-}" ] || { echo "(대역) frontend 이름을 바꾼 뒤 실패 주입"; exit 1; }
        exit 0
      fi
      h=$(cat "$ST/HEAD"); jar=${BUILD_JAR:-$(cat "$SIM/fix/jar-$h" 2>/dev/null)}
      [ -n "$jar" ] || { echo "대역: HEAD $h 의 jar 없음"; exit 1; }
      id=$(isp build "$ST" backend "be-$h-$(now)-$jar") || exit 1
      echo "$jar" > "$ST/img/${id#sha256:}"; echo "$id" > "$ST/tag/latest"
      echo "(대역) building backend from HEAD ${h:0:7} → ${id:0:19}" ;;
    up)
      if [ "${@: -1}" = frontend ]; then setctr frontend "$(cat "$ST/fetag/latest")"; date -u -d "@$(now)" '+%Y-%m-%dT%H:%M:%S.000000000Z' > "$ST/frontend.started"; echo " Container autotrader-frontend-1  Started (대역)"; exit 0; fi
      img=$(cat "$ST/tag/latest"); setctr backend "$img"
      [ "$img" = "$(cat "$SIM/fix/img26")" ] || touch "$ST/v96"   # 새 backend 기동 = Flyway 가 V96 적용(되돌려도 남는다)
      date -u -d "@$(now)" '+%Y-%m-%dT%H:%M:%S.000000000Z' > "$ST/backend.started"
      if [ "$img" = "$(cat "$SIM/fix/img26")" ]; then cp "$SIM/fix/log-${ROLLLOG:-normal}.log" "$ST/backend.log"; else cp "$SIM/fix/log-${NEWLOG:-normal}.log" "$ST/backend.log"; fi
      echo " Container autotrader-backend-1  Started (대역)" ;;
    logs) if [ "${@: -1}" = frontend ]; then echo "(대역) frontend ready"; else cat "$ST/backend.log"; fi ;;
    *) forbid "docker-compose-$sub" "$@" ;;
  esac
  exit 0
fi
case "$1" in
  inspect) [ "$2" = --format ] || forbid docker-inspect "$@"; f=$3; c=$4
    if [ "$c" = cid-tmp ]; then i=$(cat "$ST/tmpcid"); echo "${f//\{\{.Image\}\}/$i}"; exit 0; fi
    s=$(svcofcid "$c") || { echo "Error: No such object: $c" >&2; exit 1; }
    if [ "$f" = '{{.Config.Image}}' ]; then [ "$s" = frontend ] && { echo autotrader-frontend; exit 0; }; forbid docker-inspect-config "$@"; fi
    read -r cid img m < "$ST/ctr/$s"
    [ -z "${CTR_NOMAN:-}" ] || [ "$CTR_NOMAN" != "$s" ] || m=null
    arch=${CTR_ARCH:-amd64}; case "$cid" in 743dfebac8c0*|9a63d15ab110*) ;; *) arch=${CTR_ARCH_NEW:-$arch} ;; esac   # CTR_ARCH_NEW: 새로 만든 컨테이너에만 주입
    if [ "$m" = null ]; then j=null; else j="{\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"digest\":\"$m\",\"size\":1624,\"platform\":{\"architecture\":\"$arch\",\"os\":\"linux\"}}"; fi
    f=${f//\{\{.Id\}\}/$cid}; f=${f//\{\{.Image\}\}/$img}; f=${f//\{\{json .ImageManifestDescriptor\}\}/$j}; echo "${f//\{\{.State.StartedAt\}\}/$(startofsvc $s)}" ;;
  image) case "$2" in
      inspect) if [ "$3" = --format ]; then [ "$4" = '{{.Id}}' ] || forbid docker-image-inspect-format "$@"; idof "$5" || { echo "Error response from daemon: No such image: $5" >&2; exit 1; }
               else idof "$3" > /dev/null || { echo "Error response from daemon: No such image: $3" >&2; exit 1; }; echo '[{"대역":1}]'; fi ;;
      save) [ "$3" = --platform ] && [ "$4" = linux/amd64 ] && [ $# = 5 ] || forbid docker-image-save "$@"
            t=$(idof "$5") || { echo "Error response from daemon: No such image: $5" >&2; exit 1; }
            [ -z "${SAVE_FAIL:-}" ] || { echo "(대역) save 실패 주입" >&2; exit 1; }
            isp save "$ST" "$t" ;;
      *) forbid docker-image "$@" ;;
    esac ;;
  tag) id=$(idof "$2") || { echo "Error response from daemon: No such image: $2" >&2; exit 1; }
    case "$3" in autotrader-frontend) echo "$id" > "$ST/fetag/latest" ;; autotrader-frontend:*) echo "$id" > "$ST/fetag/${3#autotrader-frontend:}" ;; autotrader-backend:*) echo "$id" > "$ST/tag/${3#autotrader-backend:}" ;; *) forbid docker-tag "$@" ;; esac ;;
  cp) c=${2%%:*}; if [ "$c" = cid-tmp ]; then i=$(cat "$ST/tmpcid"); else s=$(svcofcid "$c") || exit 1; i=$(cut -d' ' -f2 "$ST/ctr/$s"); fi
      [ -e "$ST/img/${i#sha256:}" ] || { echo "대역: 컨테이너 이미지 ${i:0:19} 의 jar 를 모름" >&2; exit 1; }; cp "$(cat "$ST/img/${i#sha256:}")" "$3" ;;
  create) idof "$2" > "$ST/tmpcid" || exit 1; echo cid-tmp ;;
  rm) echo "$2" ;;
  *) forbid "docker-$1" "$@" ;;
esac
