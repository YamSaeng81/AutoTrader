+        Instant now = judgeNow();   // v1.155 §3 — 판단 시계
         return CandleFreshnessGuard.btcGate(timeframe, btc, btc, now,
                 candleFreshnessGuard == null ? null : candleFreshnessGuard.maintenanceExemption("KRW-BTC", timeframe, now));
     }
