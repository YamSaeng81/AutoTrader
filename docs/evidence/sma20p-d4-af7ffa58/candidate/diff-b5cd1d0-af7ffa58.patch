+                        .contentType(MediaType.APPLICATION_JSON).content(body))
+                .andReturn().getResponse().getStatus();
+        assertThat(status).isEqualTo(400);
+        assertThat(balanceRepo.count()).isEqualTo(before);
+    }
+}
