     private final com.cryptoautotrader.api.repository.OrderRepository orderRepository;
 
+    /**
+     * DYNAMIC REAL 보호식·전체 REAL 보호식의 자본 기준(RUNNING DYNAMIC REAL 초기자본) — 총괄 v1.158 결정 2. 스프링 문맥에서는 항상 주입된다.
