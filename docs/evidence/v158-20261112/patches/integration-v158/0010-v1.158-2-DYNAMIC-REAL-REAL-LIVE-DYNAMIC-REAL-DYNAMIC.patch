+        BigDecimal rolled = dynLoss();
+        Instant appliedAfterRollback = orderRepository.findById(o.getId()).orElseThrow().getSellAppliedAt();
+        confirm("DYNAMIC");
+        BigDecimal once = dynLoss();
+        confirm("DYNAMIC");
