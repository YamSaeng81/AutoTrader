+    private void holdWorkers(boolean fillQueue) throws Exception {
+        ThreadPoolExecutor pool = orderExecutor.getThreadPoolExecutor();
+        ExecutorBarrier.awaitPriorTasks(pool, 15_000);
+        release = new CountDownLatch(1);
