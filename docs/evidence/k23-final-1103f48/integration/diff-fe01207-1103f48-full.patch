+            out.add(Candle.builder().time(lastOpen.minus(i, ChronoUnit.HOURS))
+                    .open(p).high(p.add(BigDecimal.ONE)).low(p.subtract(BigDecimal.ONE)).close(p)
+                    .volume(new BigDecimal("1000")).build());
+        }
+        return out;
+    }
