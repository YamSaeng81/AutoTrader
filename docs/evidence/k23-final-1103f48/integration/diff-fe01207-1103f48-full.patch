+    static Duration windowOf(String tf) {
+        Duration t = Duration.ofMinutes(TimeframeUtils.toMinutes(tf));
+        return t.dividedBy(2).compareTo(Duration.ofMinutes(5)) < 0 ? t.dividedBy(2) : Duration.ofMinutes(5);
