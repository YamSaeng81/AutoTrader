+    storageState: STORAGE_STATE,
+  },
+  webServer: {
+    command: 'npx next dev -p 3210',
+    env: { AUTH_PASSWORD, AUTH_SECRET },
+    url: 'http://localhost:3210',
+    reuseExistingServer: false,
+    timeout: 180000,
+  },
+});
