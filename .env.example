# ────────────────────────────────────────────
# 백엔드 (Spring Boot) 환경변수
# 복사 후 실제 값으로 교체: cp .env.example .env
# ────────────────────────────────────────────

# Database
DB_PASSWORD=your_secure_password

# API 인증 토큰 — ApiTokenAuthFilter에서 검증 (미설정 시 서버 시작 실패)
API_AUTH_TOKEN=your-strong-random-token-here

# DB 초기화(설정 > DB 초기화) 확인 비밀번호.
# 미설정 시 초기화 기능이 완전히 비활성화된다(모든 요청 401).
DB_RESET_PASSWORD=your_db_reset_password

# Redis 비밀번호 — docker-compose.prod.yml Redis와 동일한 값 사용
REDIS_PASSWORD=your_redis_password

# Upbit API (AES-256 암호화된 값)
UPBIT_ACCESS_KEY_ENCRYPTED=encrypted_value_here
UPBIT_SECRET_KEY_ENCRYPTED=encrypted_value_here

# AES-256 암호화 키 (32 bytes)
AES_KEY=your-256-bit-secret-key-minimum-32-chars

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=your_chat_id

# Host (운영 서버 IP)
HOST_IP=your_server_ip_or_domain

# DDNS 도메인 (포트포워딩 + DDNS 사용 시, 없으면 빈 값으로 둬도 됨)
DDNS_HOST=yourname.ddns.net

# ── Grafana ──────────────────────────────────────────────────────────────────
# 관리자 비밀번호 — 미설정 시 컨테이너 시작 실패.
# 외부에 노출한다면 20자 이상 난수로 쓸 것(무차별 대입 대상이 된다).
GRAFANA_PASSWORD=your_grafana_password

# 아래 셋은 "어떻게 접속하느냐"에 따라 셋트로 정한다. 셋 중 하나를 고르면 된다.
#
# ┌ (A) 기본 — SSH 터널로만 본다. 외부 노출 없음. 가장 안전하다.
# │     GRAFANA_BIND / ROOT_URL / DOMAIN / COOKIE_SECURE 전부 비워두면 된다.
# │     접속: ssh -L 3001:127.0.0.1:3001 <user>@<host>  후 http://localhost:3001
# │
# ├ (B) Cloudflare Tunnel (권장) — 서버 포트를 하나도 열지 않는다.
# │     cloudflared 가 서버 안에서 127.0.0.1:3001 로 붙으므로 GRAFANA_BIND 는 그대로 둔다.
# │     GRAFANA_ROOT_URL=https://grafana.yhdeabba.com
# │     GRAFANA_DOMAIN=grafana.yhdeabba.com
# │     GRAFANA_COOKIE_SECURE=true
# │
# └ (C) Cloudflare DNS 프록시로 원본 IP:포트 직접 지정 — 포트를 열어야 한다.
#       GRAFANA_BIND=0.0.0.0:3001
#       GRAFANA_ROOT_URL=https://grafana.yhdeabba.com
#       GRAFANA_DOMAIN=grafana.yhdeabba.com
#       GRAFANA_COOKIE_SECURE=true
#       ⚠️ Cloudflare 가 프록시할 수 있는 HTTPS 포트는 443·2053·2083·2087·2096·8443 뿐이다.
#          3001 은 목록에 없으므로 원본 포트를 지원 포트로 바꾸거나 (B) 를 쓸 것.
#       ⚠️ 반드시 방화벽에서 Cloudflare IP 대역만 허용할 것. 아니면 도메인을 우회해
#          http://<원본IP>:3001 로 그냥 들어올 수 있고 Cloudflare 보호가 무의미해진다.
#
# 미설정 시 기본값: GRAFANA_BIND=127.0.0.1:3001 (외부 접속 불가)
GRAFANA_BIND=
GRAFANA_ROOT_URL=
GRAFANA_DOMAIN=
GRAFANA_COOKIE_SECURE=

# Discord
DISCORD_BOT_TOKEN=your_discord_bot_token

# Anthropic Claude — 모닝 브리핑 AI 시황/뉴스 요약(LLM)에 사용.
# ClaudeProvider가 이 값을 DB(llm_provider_config.api_key)보다 우선 사용한다.
# 발급: https://console.anthropic.com/settings/keys (+ Billing 크레딧 필요)
ANTHROPIC_API_KEY=sk-ant-...

# ── 전략 안전장치 (운영 동작을 바꾸는 값. 기본값 = 현재 운영 상태) ──────────
# Walk-forward 게이트. true 로 켜면 out-of-sample 검증이 없는 전략의
# LIVE/DYNAMIC 세션 생성이 전면 중단된다.
# 켜기 전에 GET /api/v1/strategies/walk-forward-gate-status 로 어떤 전략이
# 막히는지 먼저 확인할 것. 미설정 시 false(= 검증 없는 전략도 통과).
REQUIRE_WALK_FORWARD_GATE=false

# 전략 SELL 신호에 의한 청산. 기본 off 는 실측 근거가 있는 의도적 선택이다 —
# DYN_PAPER 청산 335건 중 이 경로 110건이 -10,298원으로 적자 전액을 차지했고,
# 빼면 나머지 합이 +2,609원이었다. 근거 없이 켜지 말 것.
STRATEGY_SIGNAL_EXIT_ENABLED=false

# 프론트엔드 인증
API_TOKEN=your-api-token
AUTH_PASSWORD=your-auth-password
AUTH_SECRET=your-auth-secret-minimum-32-chars
